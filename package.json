{
  "name": "tumble-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tumble Rush — a single-player 3D bean battle-royale party game for the browser.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && vitest run && vite build",
    "lint": "tsc --noEmit",
    "verify:show": "playwright test e2e/review2.spec.ts",
    "check:release": "npm run check && playwright test e2e/review1.spec.ts e2e/review2.spec.ts",
    "measure:show": "node scripts/measure-show.mjs",
    "verify:pacing": "node scripts/verify-pacing.mjs",
    "evidence": "playwright test e2e/screenshots.spec.ts",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/three": "0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
